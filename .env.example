# ==============================================================================
# Bildx AI Image-Ad Generator Configuration Environment Variables
# ==============================================================================

# Application Environment (development, production, test)
APP_ENV=development
HOST=0.0.0.0
PORT=8000
DEBUG=false

# AI Provider Selection: 'fake', 'gemini', or 'openai'
# Default is 'fake' (deterministic, zero cost, recommended for automated testing)
AI_PROVIDER=fake

# Concurrency & Capacity Limits (Rubric 25%)
# Maximum simultaneous AI provider calls (governed by in-memory asyncio.Semaphore)
MAX_CONCURRENT_PROVIDER_CALLS=3

# Maximum total active tasks in queue before returning HTTP 429 Too Many Requests
MAX_QUEUE_CAPACITY=20

# Timeouts & Resource Constraints (in seconds)
PROVIDER_TIMEOUT_SECONDS=15.0
IMAGE_DOWNLOAD_TIMEOUT_SECONDS=10.0
IMAGE_DOWNLOAD_MAX_BYTES=10485760  # 10 MB strict limit

# Retry Policy for Transient Errors (HTTP 429, 503, Network Drops)
MAX_RETRIES=3
RETRY_INITIAL_DELAY_SECONDS=0.5
RETRY_BACKOFF_FACTOR=2.0

# Storage directory for completed ad PNG images
OUTPUT_DIR=backend/output_ads

# --- Optional Real Model Credentials (leave blank to use FakeAIProvider) ---

# Google Gemini API
# Get key from https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# OpenAI API
# Get key from https://platform.openai.com/
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
